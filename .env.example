# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 들어가지 않는다.
#   uvicorn app.main:app --env-file .env
#
# 하나도 없어도 서버는 뜬다 — 전화는 FakeTelephony, 응답은 고정 비프로 간다.
# 다만 CLOVA 여섯 개는 "전부 있거나 전부 없거나"다. 반만 채우면 대화를
# 시작하지 않는다(어르신이 말했는데 침묵하는 상태가 가장 나쁘다).

# --- 전화망 (ClawOps) ---
CLAWOPS_ACCOUNT_SID=
CLAWOPS_API_KEY=
CLAWOPS_FROM_NUMBER=

# --- 어르신 전화번호 (DB가 붙기 전까지) ---
# 형식: "1:070-1111-2222,2:070-3333-4444"
ELDER_PHONES=

# --- 공개 주소 (사업자가 우리에게 접속할 주소) ---
PUBLIC_BASE_URL=
STREAM_BASE_URL=

# --- STT (CLOVA Speech 장문 인식 도메인) ---
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# --- LLM (CLOVA Studio) ---
CLOVA_STUDIO_BASE_URL=
CLOVA_STUDIO_API_KEY=
# CLOVA_STUDIO_MODEL=HCX-DASH-002

# --- TTS (CLOVA Voice) ---
# 주의: Voice는 월 정액이다. 개발 기간에는 켜지 않는 편이 낫다.
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# CLOVA_VOICE_SPEAKER=nara_call
# speed는 양수가 '느리게'다. 어르신께는 천천히 말하는 쪽이지만
# 얼마가 적당한지는 실제 통화를 들어 봐야 안다 — 지금은 중립(0).
# CLOVA_VOICE_SPEED=0
