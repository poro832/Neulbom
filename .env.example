# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 들어가지 않는다.
#   cp .env.example .env
#   uvicorn app.main:app --env-file .env
#
# 하나도 안 채워도 서버는 뜬다 — 전화는 FakeTelephony, 응답은 고정 비프로
# 간다. 계정 신청이 끝나기 전에도 전화 경로 자체는 끝까지 검증된다.
#
# 다만 "대화하는 AI"가 되려면 아래 1장의 여섯 개가 **전부** 있어야 한다.
# 반만 채우면 대화를 시작하지 않는다 — 알아듣고 답까지 만들어 놓고 소리를
# 안 내는 상태가 가장 나쁘다. 어르신은 전화가 끊긴 줄 안다.


# ════════════════════════════════════════════════════════════
# 1. 대화에 필요한 여섯 개 — 전부 있거나 전부 없거나
# ════════════════════════════════════════════════════════════

# --- 음성인식 (CLOVA Speech) ---
# NCP 콘솔의 CLOVA Speech 도메인은 유형이 셋(장문 / 단문 / 스트리밍)이고
# **도메인마다 시크릿이 다르다.** 통화 후 장문 전사는 장문 도메인의 값을,
# 통화 중 단문 인식은 단문 도메인의 값을 쓴다. 단문 도메인을 따로 만들지
# 않았다면 장문 시크릿으로 불러 401 Invalid secret이 난다(2026-10-06).
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 단문 인식 도메인의 시크릿. 비워 두면 위 CLOVA_SPEECH_SECRET을 쓴다.
CLOVA_SPEECH_SHORT_SECRET=

# --- 대화 생성 (CLOVA Studio) ---
CLOVA_STUDIO_BASE_URL=
CLOVA_STUDIO_API_KEY=
# CLOVA_STUDIO_MODEL=HCX-DASH-002

# --- 음성 합성 (Prosody / 휴멜로 DIVE) ---
# 목소리 이름에 기본값을 두지 않았다. 화자가 114명이고 어느 목소리가
# 어르신께 맞는지는 들어 봐야 아는데, 기본값이 있으면 아무도 안 듣고
# 그대로 시연까지 간다. 비어 있으면 고정 응답으로 내려간다.
#
# 콘솔 플레이그라운드에서 연령대(노년 포함)로 걸러 들어 보고 고른다.
#   https://console.humelo.com/playground
# 8kHz로 떨어뜨려 들을 것 — 어르신은 전화기로 듣는다.
#   ffmpeg -i in.wav -ar 8000 -ac 1 out.wav
PROSODY_API_KEY=
PROSODY_VOICE_NAME=
# PROSODY_EMOTION=neutral
# speed는 배율이다. 1.0이 원음이고 1보다 작으면 느리다(0.5~2.0).
# CLOVA Voice와 부호 규약이 반대다 — 거기선 양수가 '느리게'였다.
# PROSODY_SPEED=1.0
# 플랜의 월 글자 수. 로그의 "월 한도의 N%"와 80% 경고에 쓴다. Free 10000,
# Starter 66666. 넘기면 과금이 아니라 다음 달까지 정지다.
# PROSODY_MONTHLY_CHARS=10000


# ════════════════════════════════════════════════════════════
# 2. 실제로 전화를 걸려면
# ════════════════════════════════════════════════════════════

# --- 전화망 (ClawOps) ---
# 비우면 FakeTelephony로 돈다. 실제 발신은 안 나간다.
CLAWOPS_ACCOUNT_SID=
CLAWOPS_API_KEY=
CLAWOPS_FROM_NUMBER=

# --- 공개 주소 (사업자가 우리에게 접속할 주소) ---
# 웹훅은 https://, 스트림은 wss://다.
PUBLIC_BASE_URL=
STREAM_BASE_URL=


# ════════════════════════════════════════════════════════════
# 3. 저장소
# ════════════════════════════════════════════════════════════

# --- 데이터베이스 ---
# 비우면 메모리 저장소로 돈다 — 서버를 끄면 통화 이력과 점수가 다 사라진다.
# 값이 있으면 통화 저장소와 결과 저장소가 **함께** Postgres로 간다. 하나만
# 고르는 길은 두지 않았다: 통화는 남는데 점수가 없으면 기준선이 빈 표본에서
# 만들어져 아무 오류 없이 점수만 틀린다.
#
# 개발(로컬 Docker):
#   docker run -d --name nulbom-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=nulbom postgres:16
#   DATABASE_URL=postgresql://postgres:dev@localhost:5432/nulbom
#
# 배포: RDS. SSM Parameter Store 권한이 거부돼(2026-09-25) 접속 문자열도
# 이 파일에 둔다. 서버에서는 chmod 600으로 막는다.
#
# 스키마를 올린 뒤 명부를 채운다:
#   psql "$DATABASE_URL" -f db/schema.sql
#   python -m app.seed_elders
DATABASE_URL=

# --- 어르신 전화번호 ---
# 형식: "1:070-1111-2222,2:070-3333-4444"
#
# DB가 붙은 뒤에도 명부의 출처는 아직 여기다. python -m app.seed_elders가
# 이 값을 읽어 guardians/elders 행으로 옮긴다. 보호자 화면이 생기면
# 없어질 임시 다리다.
#
# 주의: 그 스크립트는 동의(consent_at)를 채우지 않는다. 비어 있으면 그
# 어르신은 발신 대상에서 빠진다 — 동의는 사람이 받는 것이다.
ELDER_PHONES=

# --- 녹음 보관 (S3) ---
# 비우면 녹음이 서버 디스크에만 남는다. 그래도 30일이 지나면 지운다 —
# 어르신께 드린 약속이라 이 설정과 무관하게 지킨다.
#
# 채우면 통화가 끝나자마자 S3에 올리고, 로컬은 24시간 뒤 지운다(전사 워커가
# 그 사이 읽는다). 서버가 켜질 때 버킷에 실제로 한 번 써 보고, 안 되면
# journal에 "S3에 쓸 수 없다"를 남긴다.
#
# 버킷의 버저닝은 켜지 않는다. 켜면 30일 규칙이 삭제 표시만 남기고
# 어르신 육성은 이전 버전으로 그대로 남는다.
RECORDINGS_BUCKET=
# 기본은 ap-northeast-2. 비우면 코드의 기본값을 쓴다 — 환경에 맡기면 개발
# PC의 ~/.aws/config를 읽어 서버와 다르게 동작한다.
# AWS_REGION=ap-northeast-2


# ════════════════════════════════════════════════════════════
# 4. 점수에 영향을 주는 스위치 — 시연 2주 전에 정하고 안 건드린다
# ════════════════════════════════════════════════════════════

# --- 배치 전사 ---
# 통화 녹음을 글로 바꿔 부정 표현 20점을 잰다.
#
# 기본은 꺼짐이다. 켜는 순간 위험 점수의 실질 만점이 60에서 80으로 바뀌므로,
# 켜기 전후의 점수를 같은 추이로 보면 안 된다. 기준선 창이 14통이라 시연
# 2주 전에 켜고 그 뒤로는 건드리지 않는다.
#
# 키는 위 CLOVA_SPEECH_*를 그대로 쓴다.
BATCH_TRANSCRIPTION=off

# --- TTS 벤더: prosody | clova | polly (기본 prosody) ---
# 벤더를 바꾸면 AI 발화 길이가 달라지고, 그게 지표의 분모(통화 전체 − AI
# 발화)를 바꾼다. 즉 **바꾸는 순간 점수 시계열이 끊긴다.** 배치 전사와 같은
# 규칙으로 다룬다.
#
# 지금은 바꾸는 값이 0이다 — 실제 통화가 아직 0통이라 끊어질 시계열이 없다.
# 첫 통화가 들어오는 순간부터 이 값은 고정이다.
TTS_VENDOR=prosody


# ════════════════════════════════════════════════════════════
# 5. 돌아갈 자리 — 평소에는 비워 둔다
# ════════════════════════════════════════════════════════════
#
# 벤더 교체는 TTS_VENDOR 한 줄이다. 갈래를 지우지 않고 남겨 두는 이유가
# 이것이다 — 없애면 다시 낼 때 어댑터와 테스트를 새로 써야 한다.

# --- CLOVA Voice ---
# 프레소디 목소리가 어르신께 안 맞으면 여기로 온다.
# 주의: 채우는 순간 월 정액(약 ₩99,000)이 시작된다.
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# CLOVA_VOICE_SPEAKER=nara_call
# speed는 양수가 '느리게'다. 프레소디와 반대다.
# CLOVA_VOICE_SPEED=0

# --- Amazon Polly (지금은 쓸 수 없다) ---
# 2026-09-25 권한 거부. Polly에는 사용량 상한을 거는 IAM 조건이 없고
# AWS Budgets는 차단이 아니라 알림이라, 공유 수업 계정에서는 내주지
# 않는다. 계정 정책이 바뀌거나 전용 계정이 생기면 돌아갈 수 있다.
# 자격 증명은 인스턴스 프로파일에서 찾으므로 여기 키가 없다.
# POLLY_VOICE_ID=Seoyeon
# AWS_REGION=ap-northeast-2
