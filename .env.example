# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 들어가지 않는다.
#   uvicorn app.main:app --env-file .env
#
# 하나도 없어도 서버는 뜬다 — 전화는 FakeTelephony, 응답은 고정 비프로 간다.
# 다만 CLOVA 여섯 개는 "전부 있거나 전부 없거나"다. 반만 채우면 대화를
# 시작하지 않는다(어르신이 말했는데 침묵하는 상태가 가장 나쁘다).

# --- 전화망 (ClawOps) ---
CLAWOPS_ACCOUNT_SID=
CLAWOPS_API_KEY=
CLAWOPS_FROM_NUMBER=

# --- 어르신 전화번호 (DB가 붙기 전까지) ---
# 형식: "1:070-1111-2222,2:070-3333-4444"
ELDER_PHONES=

# --- 공개 주소 (사업자가 우리에게 접속할 주소) ---
PUBLIC_BASE_URL=
STREAM_BASE_URL=

# --- STT (CLOVA Speech 장문 인식 도메인) ---
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# --- LLM (CLOVA Studio) ---
CLOVA_STUDIO_BASE_URL=
CLOVA_STUDIO_API_KEY=
# CLOVA_STUDIO_MODEL=HCX-DASH-002

# --- TTS 벤더 선택: clova | polly (기본 clova) ---
# polly를 쓴다. 시연까지 이대로 간다.
#
# CLOVA Voice는 100만 자까지 같은 값인 월 정액(약 ₩99,000)인데 우리 사용량은
# 월 1만 2천 자쯤이라 한도의 1.2%를 쓰면서 정액을 내게 된다.
#
# 바꾸지 않는 것이 가장 싸다: 벤더를 바꾸면 AI 발화 길이가 달라지고 그게
# 지표의 분모를 바꾼다. 기준선 창이 14통이라 바꾸려면 최소 2주 전에 해야 하고,
# 그 전후 점수는 같은 추이로 볼 수 없다. 안 바꾸면 이 문제가 통째로 없다.
#
# CLOVA Voice는 비상구다. 실제로 8kHz로 들어 보고 "어르신께 못 들려드리겠다"
# 싶을 때만 간다 — 들어 보기 전에 미리 정해 둘 일이 아니다.
TTS_VENDOR=polly

# --- TTS: Polly (종량제. 자격 증명은 인스턴스 프로파일에서 찾는다) ---
# POLLY_VOICE_ID=Seoyeon
# AWS_REGION=ap-northeast-2

# --- TTS: CLOVA Voice (비상구. 평소에는 비워 둔다) ---
# 주의: 켜는 순간 월 정액이 시작되고, 그 시점 전후의 점수는 비교할 수 없다.
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# CLOVA_VOICE_SPEAKER=nara_call
# speed는 양수가 '느리게'다. 어르신께는 천천히 말하는 쪽이지만
# 얼마가 적당한지는 실제 통화를 들어 봐야 안다 — 지금은 중립(0).
# CLOVA_VOICE_SPEED=0

# --- 배치 전사 ---
# 배치 전사 — 통화 녹음을 글로 바꿔 부정 표현 20점을 잰다.
#
# 기본은 꺼짐이다. 켜는 순간 위험 점수의 실질 만점이 60에서 80으로 바뀌므로,
# 켜기 전후의 점수를 같은 추이로 보면 안 된다. TTS 벤더 교체와 같은 규칙으로
# 다룬다 — 시연 2주 전에 켜고 그 뒤로는 건드리지 않는다.
#
# 키는 단문 인식과 같은 것을 쓴다(CLOVA_SPEECH_*). 별도 발급이 필요 없다.
BATCH_TRANSCRIPTION=off
