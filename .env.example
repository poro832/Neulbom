# 이 파일을 .env로 복사해서 값을 채운다. .env는 저장소에 들어가지 않는다.
#   uvicorn app.main:app --env-file .env
#
# 하나도 없어도 서버는 뜬다 — 전화는 FakeTelephony, 응답은 고정 비프로 간다.
# 다만 CLOVA 여섯 개는 "전부 있거나 전부 없거나"다. 반만 채우면 대화를
# 시작하지 않는다(어르신이 말했는데 침묵하는 상태가 가장 나쁘다).

# --- 전화망 (ClawOps) ---
CLAWOPS_ACCOUNT_SID=
CLAWOPS_API_KEY=
CLAWOPS_FROM_NUMBER=

# --- 어르신 전화번호 (DB가 붙기 전까지) ---
# 형식: "1:070-1111-2222,2:070-3333-4444"
ELDER_PHONES=

# --- 공개 주소 (사업자가 우리에게 접속할 주소) ---
PUBLIC_BASE_URL=
STREAM_BASE_URL=

# --- STT (CLOVA Speech 장문 인식 도메인) ---
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# --- LLM (CLOVA Studio) ---
CLOVA_STUDIO_BASE_URL=
CLOVA_STUDIO_API_KEY=
# CLOVA_STUDIO_MODEL=HCX-DASH-002

# --- TTS 벤더 선택: clova | polly (기본 clova) ---
# clova를 쓴다. 고른 게 아니라 남은 것이 그것뿐이다.
#
# 2026-09-25: 수업 계정에 낸 Polly 권한 신청이 거부됐다. 사유는 타당하다 —
# Polly에는 글자 수나 호출 수로 걸 수 있는 IAM 조건이 없고, AWS Budgets는
# 알림이지 차단이 아니다. 공유 계정에서 상한 없는 종량제 권한을 주지 않는
# 건 맞는 판단이다. 어댑터는 지우지 않고 남겨 둔다(맨 아래).
#
# 비용: CLOVA Voice는 100만 자까지 같은 값인 월 정액(약 ₩99,000)이고 우리
# 사용량은 월 1만 2천 자쯤이다. 한도의 1.2%를 쓰면서 정액을 낸다. 그래서
# 실제 통화를 시작하는 달에 켜고, 그전에는 고정 응답으로 개발한다 — 키를
# 비워 두면 responder_from_env()가 알아서 고정 응답으로 내려간다.
#
# 바꾸는 비용은 지금이 0이다: 벤더를 바꾸면 AI 발화 길이가 달라져 지표의
# 분모가 바뀌는데, 실제 통화가 아직 0통이라 끊어질 시계열이 없다. 첫 통화가
# 들어오는 순간부터 이 값은 고정이다.
TTS_VENDOR=clova

# --- TTS: CLOVA Voice (기본) ---
# 주의: 채우는 순간 월 정액이 시작된다. 실통화 전까지는 비워 둔다.
# format=wav에서 8kHz를 직접 준다 — 전화망이 8kHz라 리샘플링이 한 번도 없다.
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
# CLOVA_VOICE_SPEAKER=nara_call
# speed는 양수가 '느리게'다. 어르신께는 천천히 말하는 쪽이지만
# 얼마가 적당한지는 실제 통화를 들어 봐야 안다 — 지금은 중립(0).
# CLOVA_VOICE_SPEED=0

# --- 배치 전사 ---
# 배치 전사 — 통화 녹음을 글로 바꿔 부정 표현 20점을 잰다.
#
# 기본은 꺼짐이다. 켜는 순간 위험 점수의 실질 만점이 60에서 80으로 바뀌므로,
# 켜기 전후의 점수를 같은 추이로 보면 안 된다. TTS 벤더 교체와 같은 규칙으로
# 다룬다 — 시연 2주 전에 켜고 그 뒤로는 건드리지 않는다.
#
# 키는 단문 인식과 같은 것을 쓴다(CLOVA_SPEECH_*). 별도 발급이 필요 없다.
BATCH_TRANSCRIPTION=off

# --- 데이터베이스 ---
# 비워 두면 메모리 저장소로 돈다 — 서버를 끄면 통화 이력과 점수가 다 사라진다.
# 값이 있으면 통화 저장소와 결과 저장소가 함께 Postgres로 간다. 하나만 고르는
# 길은 두지 않았다: 통화는 남는데 점수가 없으면 기준선이 빈 표본에서 만들어져
# 아무 오류 없이 점수만 틀린다.
#
# 개발(로컬 Docker): postgres:16 컨테이너
#   docker run -d --name nulbom-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=nulbom postgres:16
#   psql "$DATABASE_URL" -f db/schema.sql
# 배포: RDS. 접속 문자열은 Parameter Store에서 읽는다 — 여기 적지 않는다.
#
# 스키마를 올린 뒤 어르신 명부를 채운다: python -m app.seed_elders
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/nulbom


# --- TTS: Polly (지금은 쓸 수 없다) ---
# 2026-09-25 권한 거부. 계정 정책이 바뀌거나 전용 계정이 생기면 TTS_VENDOR를
# polly로 되돌리는 한 줄로 돌아갈 수 있게 어댑터와 테스트를 남겨 두었다.
# POLLY_VOICE_ID=Seoyeon
# AWS_REGION=ap-northeast-2