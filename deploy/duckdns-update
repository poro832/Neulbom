#!/bin/sh
# /usr/local/bin/duckdns-update — 인스턴스의 공인 IP를 DuckDNS에 알린다.
#
# Elastic IP 권한이 없어서(ec2:AllocateAddress 거부) 인스턴스를 중지했다
# 시작하면 IP가 바뀐다. duckdns.timer가 5분마다 이걸 돌려 도메인이 따라가게
# 한다. ip=를 비워 두면 DuckDNS가 요청을 보낸 주소를 쓴다.
set -eu
. /etc/duckdns.env
name=$(printf %s "$DDNS_NAME" | tr -d '\r[:space:]')
token=$(printf %s "$DDNS_TOKEN" | tr -d '\r[:space:]')
# 한글 입력 모드로 치면 안 보이는 바이트가 섞인다(2026-09-30에 실제로 겪었다 —
# 화면엔 nuelbom인데 실제로는 n + 0xE3 + nuelbom이었다). 주소에 넣기 전에
# 모양을 보고, 틀리면 무엇이 틀렸는지 말하고 멈춘다. 안 그러면 DuckDNS가
# 이유 없이 400만 돌려준다.
printf %s "$name" | LC_ALL=C grep -qx '[a-z0-9-]\{1,63\}' || { echo "DDNS_NAME에 영문 소문자/숫자/- 외의 문자가 있다" >&2; exit 1; }
printf %s "$token" | LC_ALL=C grep -qx '[0-9a-f-]\{36\}' || { echo "DDNS_TOKEN 모양이 틀렸다(36자)" >&2; exit 1; }
r=$(curl -fsS "https://www.duckdns.org/update?domains=${name}&token=${token}&ip=")
[ "$r" = "OK" ] || { echo "DuckDNS 갱신 실패: $r" >&2; exit 1; }
