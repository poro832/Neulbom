# /etc/caddy/Caddyfile — HTTPS를 받아 앱(127.0.0.1:8000)으로 넘긴다.
#
# 인증서는 Caddy가 Let's Encrypt에서 알아서 받고 갱신한다. 그러려면
# 보안그룹에 80번이 열려 있어야 한다(발급 확인이 80으로 온다).
nuelbom.duckdns.org {
	# 인터넷에 여는 건 전화망 사업자가 부르는 네 경로와, 열쇠(또는 연결 코드)를 요구하는
	# 앱용 주소들이다. 열쇠 없이는 401이고(tests/test_deploy.py가 검사한다) 어르신 데이터는
	# 그 열쇠의 주인 것만 읽힌다. 서버에 마이그레이션과 코드가 반영되기 전에는 서버의 Caddy에
	# 이 줄을 반영하지 않는다(배포 순서).
	@clawops path /v1/voiceml /v1/stream /v1/stream-ended /v1/call-status /v1/calls/request /v1/pair /v1/elders/*/pairing-code /v1/elders/*/weekly /v1/guardian/elders /v1/guardian/alerts /v1/me/calls /v1/me/contacts /v1/me/contacts/*
	handle @clawops {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond "not found" 404
	}
}
