# /etc/duckdns.env 로 만들고 root만 읽게 한다: sudo chmod 600 /etc/duckdns.env
#
# 토큰은 DuckDNS 사이트 맨 위 token 값이다. 저장소에 절대 올리지 않는다 —
# 이걸 가진 사람은 도메인이 가리키는 서버를 바꿔 어르신 통화 음성을 가로챌 수 있다.
#
# 영문 입력 모드로 쓸 것. 한글 모드로 치면 안 보이는 바이트가 섞여 400이 난다.
# 가장 안전한 건 sudo nano /etc/duckdns.env 로 열어 눈으로 보며 쓰는 것이다.
DDNS_NAME=nuelbom
DDNS_TOKEN=
